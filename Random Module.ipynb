    " # 7. Random Module\n",
    "import numpy as np\n",
    "np.random.seed(42)\n",
    "print(\"Random:\",np.random.rand(3))\n",
    "\n",
    "print(\"Random radiant\",np.random.randint(1,2,3))\n",
    "print(\"Random randn:\",np.random.randn(2))\n",
    "print(\"Random Choice\",np.random.choice([1,2,3],4))"
   ]
  }
