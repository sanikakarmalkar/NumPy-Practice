   "source": [
    "#Sorting & Searching\n",
    "import numpy as np\n",
    "\n",
    "a = np.array([2,1,5,8,9,2,2,4,6,5])\n",
    "\n",
    "print(\"Sorted:\",np.sort(a))\n",
    "print(\"Argsort:\",np.argsort(a))\n",
    "print(\"Where > 2:\", np.where(a > 2))\n",
    "print(\"Unique\",np.unique(a))\n",
    "print(\"Nor zero indices\",np.nonzero(a))\n",
    "\n"
   ]
  }
 ],
